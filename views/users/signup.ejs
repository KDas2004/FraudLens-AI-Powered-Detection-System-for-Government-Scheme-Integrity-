<% layout("/layouts/boilerplate") %>

<div style="min-height:70vh;display:flex;align-items:center;justify-content:center;">
    <div style="width:100%;max-width:420px;">

        <div style="text-align:center;margin-bottom:2rem;">
            <div style="font-family:var(--mono);font-size:1.8rem;font-weight:700;color:var(--accent);letter-spacing:4px;margin-bottom:0.5rem;">⬡ FRAUDLENS</div>
            <p style="font-family:var(--mono);font-size:0.68rem;letter-spacing:2px;color:var(--muted);">CREATE OPERATOR ACCOUNT</p>
        </div>

        <div class="fl-card">
            <form action="/signup" method="POST">

                <div style="margin-bottom:1.2rem;">
                    <label class="form-label">Username</label>
                    <input name="username" type="text" class="form-control"
                        placeholder="Choose a username" required autocomplete="username">
                </div>

                <div style="margin-bottom:1.2rem;">
                    <label class="form-label">Email Address</label>
                    <input name="email" type="email" class="form-control"
                        placeholder="your@email.com" required autocomplete="email">
                </div>

                <div style="margin-bottom:1.8rem;">
                    <label class="form-label">Password</label>
                    <input name="password" type="password" class="form-control"
                        placeholder="Create a strong password" required autocomplete="new-password">
                </div>

                <button type="submit" class="btn-fl-primary">
                    Create Account →
                </button>

            </form>

            <p style="text-align:center;font-family:var(--mono);font-size:0.68rem;color:var(--muted);margin-top:1.5rem;">
                Already have an account?
                <a href="/login" style="color:var(--accent);text-decoration:none;">Login here</a>
            </p>
        </div>

    </div>
</div>
