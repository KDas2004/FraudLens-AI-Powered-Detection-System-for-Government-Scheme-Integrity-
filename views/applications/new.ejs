<% layout("/layouts/boilerplate") %>
<div class="row application-list">
    <div class="col-8 offset-2">
        <br>
    <h3> New Application </h3>
    <form action="/applications" method="POST" enctype="multipart/form-data">

            <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input name="application[name]" 
            placeholder="Enter your name" 
            type="text" 
            class="form-control">
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input name="application[email]" 
            placeholder="Enter your email"
            class="form-control"
            >
        </div>

        <div class="mb-3">
            <label for="phone" class="form-label">Phone</label>
            <input
  name="application[phone]"
  placeholder="Enter 10-digit mobile number"
  type="text"
  class="form-control"
  pattern="[6-9][0-9]{9}"
  maxlength="10"
  minlength="10"
  required
  title="Mobile number must be 10 digits and start with 6-9">
        </div>

        <div class="mb-3">
    <label for="Aadhar Number" class="form-label">Aadhar Number</label>
    <input
  name="application[aadhaar_no]"
  placeholder="Enter 12-digit Aadhaar number"
  type="number"
  class="form-control"
  pattern="[0-9]{12}"
  maxlength="12"
  minlength="12"
  required
  title="Aadhaar must be exactly 12 digits">

</div>

<div class="mb-3">
    <label for="PAN Number" class="form-label">PAN Number</label>
    <input
  name="application[pan_no]"
  placeholder="Enter PAN number"
  type="text"
  class="form-control"
  pattern="[A-Z]{5}[0-9]{4}[A-Z]{1}"
  maxlength="10"
  required
  title="PAN must be in format ABCDE1234F">

</div>


    <div class="mb-3">
    <label for="aadhaarFile" class="form-label">Upload Aadhaar Card</label>
    <input type="file" name="aadhaarFile" id="aadhaarFile" accept="image/*,.pdf" class="form-control" required>
</div>

<div class="mb-3">
    <label for="panFile" class="form-label">Upload PAN Card</label>
    <input type="file" name="panFile" id="panFile" accept="image/*,.pdf" class="form-control" required>
</div>

        <br>
        <button class="btn btn-dark add-btn">Apply</button>
        <br> <br>
    </form>
    </div>
</div>
